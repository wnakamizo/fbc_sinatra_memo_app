<h1>新規登録</h1>

<p>登録したい内容を入力します。</p>

<% unless @errors.empty? %>
  <div class="error-messages" role="alert">
    <p>入力内容を確認してください。</p>
    <ul>
      <% @errors.each do |error| %>
        <li><%= h(error) %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form class="memo-form" action="/memos" method="post">
  <div class="form-field">
    <label for="title">タイトル</label>
    <input type="text" id="title" name="title" value="<%= h(@memo["title"]) %>">
  </div>

  <div class="form-field">
    <label for="description">内容</label>
    <textarea id="description" name="description" rows="5"><%= h(@memo["description"]) %></textarea>
  </div>

  <div class="form-actions">
    <button type="submit">送信内容を確認</button>
    <a href="/memos">一覧へ戻る</a>
  </div>
</form>
